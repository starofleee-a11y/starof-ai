# ───────────────────────────────────────────────
# Star of AI 웹사이트 환경변수
# Vercel > 프로젝트 > Settings > Environment Variables 에 같은 이름으로 넣으세요.
# 비어 있어도 사이트는 동작합니다. (해당 기능만 건너뜀) 자세한 순서는 SETUP.md
# ───────────────────────────────────────────────

# [슬랙 알림] Incoming Webhook 주소 (#C0CCWJ4MRFE 채널)
SLACK_WEBHOOK_URL=
# 또는 봇 토큰 방식
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0CCWJ4MRFE

# [메일] Resend (https://resend.com) — 고객 확정·리마인드 메일, 내 알림 메일
RESEND_API_KEY=
# 도메인 인증 후: Star of AI <hello@starof-ai.com>
MAIL_FROM=
# 알림을 받을 메일 (기본: starofleee@gmail.com)
OWNER_EMAIL=

# [커피챗] 구글 캘린더 연동 — 빈 시간 조회, 구글 미트 링크 자동 생성, 리마인드, 취소
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 비우면 기본 캘린더(starofleee@gmail.com)
GOOGLE_CALENDAR_ID=
# 리마인드 자동 실행(매시간) 보호용. 아무 긴 문자열
CRON_SECRET=
# (선택) 구글 미트 대신 쓸 고정 링크 (줌 개인 회의실 등)
MEETING_LINK=
# (선택) 취소 링크 서명용. 비우면 GOOGLE_CLIENT_SECRET 사용
APP_SECRET=

# [결제] 토스페이먼츠 결제위젯 키. 비워두면 '테스트 모드'로 동작해요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# (선택) 카드 결제 심사 전 계좌이체 안내. 예: 카카오뱅크 3333-00-0000000 이경서
NEXT_PUBLIC_BANK_ACCOUNT=
