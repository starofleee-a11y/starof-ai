# ───────────────────────────────────────────────
# Star of AI 웹사이트 환경변수
# Vercel > 프로젝트 > Settings > Environment Variables 에 같은 이름으로 넣으세요.
# 비어 있어도 사이트는 동작합니다. (해당 기능만 건너뜀)
# ───────────────────────────────────────────────

# [슬랙 알림] 둘 중 하나만 넣으면 됩니다. (#C0CCWJ4MRFE 채널)
SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0CCWJ4MRFE

# [메일 알림] Resend (https://resend.com) — 기업 문의·결제 알림 메일
RESEND_API_KEY=
# 도메인 인증 후: Star of AI <hello@starof-ai.com>
MAIL_FROM=
# 알림을 받을 메일 (기본: starofleee@gmail.com)
OWNER_EMAIL=

# [커피챗 예약] Cal.com 예약 링크 (예: starofai/coffee-chat)
NEXT_PUBLIC_CAL_LINK=
# Cal.com 웹훅 서명용 비밀값 (아무 긴 문자열)
CAL_WEBHOOK_SECRET=

# [결제] 토스페이먼츠 결제위젯 키. 비워두면 '테스트 모드'로 동작해요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
